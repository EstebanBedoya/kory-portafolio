# Paste these into the Dokploy Compose Environment tab. Never commit real values.
# DNS for both hostnames must point at the VPS. Use HTTPS, no trailing slash.
NEXT_PUBLIC_SERVER_URL=https://portfolio.example.com
S3_ENDPOINT=https://media.example.com
S3_BUCKET=kory-media
S3_PUBLIC_URL=https://media.example.com/kory-media

POSTGRES_USER=kory
POSTGRES_DB=kory
# Use hex values so DATABASE_URI does not need URL encoding: openssl rand -hex 32.
POSTGRES_PASSWORD=
PAYLOAD_SECRET=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
GALERIA_OCULTA_PASSWORD=

# Required only for the first deployment to an empty database (password 12+ chars).
# No existing user or content is overwritten. Remove these after first login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
