# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string.
# Production points at the VPS and must carry ?sslmode=verify-full.
DATABASE_URI=postgres://kory:kory@localhost:5433/kory

# Base64 of the PUBLIC certificate of the CA that signed the database server's
# certificate. Pins the server's identity so the connection cannot be
# intercepted — Vercel has no stable egress IP, so the Postgres port is
# reachable from the internet and TLS is the only defence.
# Leave empty for local development.
#   base64 -i ca.crt | tr -d '\n'
DATABASE_CA_CERT_B64=

# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------

# Signs auth tokens and cookies. Rotating it logs everyone out.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Canonical origin of the site.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage (S3-compatible)
#
# Production uses Backblaze B2. Every value here is configuration, so the
# provider can be swapped without touching code.
#   S3_ENDPOINT   https://s3.<region>.backblazeb2.com
#   S3_REGION     the literal region code, e.g. us-west-004 (not "auto")
#   S3_PUBLIC_URL https://<bucket>.s3.<region>.backblazeb2.com
#
# The bucket needs public read, plus CORS allowing PUT/GET/HEAD from this
# site's origin — browser uploads go straight to the bucket and fail with an
# opaque error if CORS is missing.
# ---------------------------------------------------------------------------

S3_BUCKET=kory-media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO, false for Backblaze B2 and Cloudflare R2
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/kory-media

# ---------------------------------------------------------------------------
# Seeding — local only. Never set these in Vercel.
# ---------------------------------------------------------------------------

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
